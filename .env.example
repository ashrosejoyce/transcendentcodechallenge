# Copy this file to .env and fill in your own values.
# Never commit .env - it is already in .gitignore.

# Required: your own Anthropic API key (https://platform.claude.com/settings/keys)
# Used for document generation and the A/B baseline comparison.
ANTHROPIC_API_KEY=sk-ant-api03-your-own-key-here

# Optional overrides (sensible defaults are used if omitted)
CLAUDE_MODEL=claude-sonnet-5

# Human-readable name of the community being analyzed - shown in the
# frontend header, used in generation prompts, and used to name
# downloaded report files. The values below are what this project's own
# deployment (analyzing beekeepingforum.co.uk) uses; the code's own
# default is the generic "this community", so a fresh clone pointed at a
# new forum doesn't need to touch anything but this file.
#
# Originally this pointed at Beemaster's Forum (beemaster.com/forum, SMF-
# based) - it since put up a Cloudflare bot challenge that blocks every
# non-browser client, so the live deployment moved to beekeepingforum.co.uk
# (XenForo-based) instead. Beemaster's Forum is still supported via
# FORUM_ADAPTER=smf if it ever becomes crawlable again - see
# backend/app/crawler/smf_adapter.py.
COMMUNITY_NAME=the Beekeeping & Apiculture Forum community

FORUM_BASE_URL=https://beekeepingforum.co.uk
# Which forum platform FORUM_BASE_URL runs: "xenforo" or "smf" are shipped
# today - see backend/app/crawler/adapter_registry.py to add support for
# another platform (phpBB, Discourse, ...).
FORUM_ADAPTER=xenforo
# Boards to skip during ingestion because they're off-topic or commercial
# rather than genuine community discussion - must be a JSON array of
# strings, matched case-insensitively as a substring so board renames
# don't silently stop being excluded.
FORUM_EXCLUDED_BOARDS=["Off Topic Chat","Beekeeping Forum Sponsor Directory","Beekeeping Forum Sponsor Market","Beekeeping Classifieds","Honey For Sale & Wanted","Blogs"]
CRAWL_LOOKBACK_DAYS=7
CRAWL_MAX_POSTS=60
# beekeepingforum.co.uk's robots.txt asks for a 5-second delay between
# requests (Crawl-delay: 5) - respected here rather than the default 1s.
CRAWL_REQUEST_DELAY_SECONDS=5
DATABASE_PATH=data/community_voices.db
EMBEDDING_MODEL=all-MiniLM-L6-v2
